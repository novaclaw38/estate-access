# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/estate_security"

# Server-side secret used to HMAC visitor OTPs before they're persisted.
# Generate with: openssl rand -hex 32
ACCESS_CODE_SECRET=""

# Meta WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Webhook (app/api/whatsapp/webhook) — set the verify token in the Meta App
# Dashboard's webhook subscription, and copy the app secret from
# App Settings > Basic to verify X-Hub-Signature-256 on inbound events.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
